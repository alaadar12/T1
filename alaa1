CREATE TABLE dept111 (
  depno   NUMBER(5) PRIMARY KEY,
  dname   VARCHAR2(30) NOT NULL,
  loc 	VARCHAR2(20)
);
CREATE TABLE emp111 (
  emono	NUMBER(4) PRIMARY KEY,
  ename	VARCHAR2(25) NOT NULL,
  jop  	VARCHAR2(10),
  mgr  	NUMBER(4),
  Hiredate DATE,
  sal  	NUMBER(7,2) CHECK (sal BETWEEN 500 AND 1900),
  Deptno   NUMBER(5) NOT NULL,
  CONSTRAINT fk_emp_dept FOREIGN KEY (Deptno) REFERENCES dept111(depno)
 
);
