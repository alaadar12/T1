-- 1. عرض الموظفين الذين رواتبهم فوق المتوسط
SELECT ename, sal
FROM emp111
WHERE sal > (SELECT AVG(sal) FROM emp111);
 
-- 2. عرض عدد الموظفين لكل قسم
SELECT d.dname, COUNT(e.emono) AS employee_count
FROM dept111 d
LEFT JOIN emp111 e ON d.depno = e.deptno
GROUP BY d.dname;
 
-- 3. عرض أعلى 3 رواتب
SELECT ename, sal
FROM emp111
ORDER BY sal DESC
FETCH FIRST 3 ROWS ONLY;
 
-- 4. عرض الموظفين الذين تم تعيينهم في 2023
SELECT ename, hiredate
FROM emp111
WHERE EXTRACT(YEAR FROM hiredate) = 2023;
 
-- 5. تحديث باستخدام CASE
UPDATE emp111
SET sal = CASE
	WHEN sal < 800 THEN sal + 300
	WHEN sal BETWEEN 800 AND 1200 THEN sal + 200
	ELSE sal + 100
END;
 
-- 6. عرض معلومات مفصلة عن الموظفين والأقسام
SELECT
	e.emono AS employee_id,
	e.ename AS employee_name,
	e.jop AS job_title,
	e.sal AS salary,
	d.dname AS department_name,
	d.loc AS location
FROM emp111 e
JOIN dept111 d ON e.deptno = d.depno
ORDER BY d.dname, e.sal DESC;
 
 
 
 
 
