-- ================================================================
-- الجزء الرابع عشر: التراجع عن التغييرات (ROLLBACK) ونقطة الحفظ (SAVEPOINT)
-- ================================================================
 
-- إنشاء نقطة حفظ
SAVEPOINT before_update;
 
-- تنفيذ عمليات
UPDATE emp111 SET sal = sal * 1.2 WHERE deptno = 10;
 
-- التراجع إلى نقطة الحفظ
ROLLBACK TO before_update;
 
-- التراجع عن آخر عملية
ROLLBACK;
 
-- تأكيد العمليات وحفظها نهائياً
COMMIT;
 
